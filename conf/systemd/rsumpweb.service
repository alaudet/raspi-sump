[Unit]
Description=Raspi-Sump Flask Web Interface
After=network.target

[Service]
ExecStart=/usr/bin/rsumpweb
Restart=on-failure
User=raspisump
LogNamespace=raspisump
UMask=0002
RuntimeDirectory=raspi-sump
RuntimeDirectoryMode=0750
WorkingDirectory=/var/lib/raspi-sump

[Install]
WantedBy=multi-user.target
